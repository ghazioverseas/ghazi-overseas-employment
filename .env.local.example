# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/ghazi_db?sslmode=require

# Better Auth Secret & Base URL
BETTER_AUTH_SECRET=your_32_character_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 Storage Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=ghazi-documents
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Public App Metadata
NEXT_PUBLIC_APP_NAME=Ghazi Employment Portal
NEXT_PUBLIC_COMPANY_NAME=Ghazi Overseas Employment Pakistan
NEXT_PUBLIC_BASE_URL=http://localhost:3000
